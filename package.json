{
  "name": "pharmacy-system",
  "version": "1.0.0",
  "private": true,
  "description": "نظام إدارة الصيدليات الشامل - مخزون، مبيعات، مشتريات، أرباح، مصروفات، ودليل أدوية",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Pharmacy System"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "reset": "npm run reset -w server",
    "app:native": "npm i better-sqlite3 && npx electron-rebuild -f -w better-sqlite3",
    "app:start": "npm run build && electron .",
    "app:dir": "npm run build && electron-builder --dir",
    "app:build": "npm run build && electron-builder --win",
    "app:build:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pharmacy.system",
    "productName": "Pharmacy System",
    "copyright": "© 2026 نظام إدارة الصيدليات",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "server/src/**/*",
      "client/dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{test,__tests__,tests,example,examples,docs,doc}/**",
      "!**/node_modules/.bin",
      "!server/data/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "PharmacySystem-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام إدارة الصيدليات",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "PharmacySystem-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/icon.png",
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.business"
    }
  }
}
