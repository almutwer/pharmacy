{
  "name": "local-pharmacy-electron",
  "version": "1.0.0",
  "description": "Arabic RTL local pharmacy management desktop app built with Electron, React, and SQLite",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "start": "npm run desktop",
    "dev": "npm run build:main && concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:web\" \"npm:dev:electron\"",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "test:electron": "npm run build",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron --enable-logging dist-electron/main.js",
    "desktop": "npm run build && electron --enable-logging dist-electron/main.js",
    "electron:direct": "electron --enable-logging dist-electron/main.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.local.pharmacy.desktop",
    "productName": "Local Pharmacy",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "db/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "db",
        "to": "db"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "PharmacyDesktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام إدارة الصيدلية"
    }
  }
}
